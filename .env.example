POP3_HOST=mail.example.com
POP3_PORT=995
POP3_USERNAME=your-email@example.com
# Recommended on Windows: store the password in Credential Manager and set only
# this non-secret target name in Codex.
POP3_CREDENTIAL_TARGET=pop3-mcp:your-email@example.com
# Cross-platform fallback only. Never commit a real password.
# POP3_PASSWORD=
POP3_TIMEOUT_MS=20000
POP3_MAX_MESSAGE_BYTES=10485760

